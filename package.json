{
  "name": "gemini-live-openai-adapter",
  "version": "1.0.0",
  "description": "OpenAI-compatible API adapter for Google Gemini Live API",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "vitest run --coverage"
  },
  "vitest": {
    "reporters": ["default", "junit"],
    "outputFile": "test-results.xml",
    "coverage": {
      "provider": "v8",
      "reporter": ["lcov", "text"]
    }
  },
  "dependencies": {
    "@google/genai": "1.29.0",
    "cors": "^2.8.5",
    "dotenv": "17.2.3",
    "express": "5.2.1",
    "helmet": "^8.1.0"
  },
  "devDependencies": {
    "vitest": "^4.0.18"
  }
}
